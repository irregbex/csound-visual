<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Csound Visual: C# / Avalonia desktop front end for Csound 7 (Windows x64 only).
    One project builds the whole application: UI (Views, ViewModels, Controls), the Csound engine
    and its WASAPI audio host (Engine, Audio, Interop), MIDI 2.0, VST3 and Ableton Link bridges
    (Integration) and the Paint Rooms (Paint). Csound itself is NOT referenced here: csound7_64.dll is
    located and loaded at run time by Interop/CsoundLocator.cs from an existing Csound 7 install.
  -->

  <!-- Core build settings: target, output layout, language features and assembly identity. -->
  <PropertyGroup>
    <!-- WinExe = Windows GUI subsystem: no console window opens with the app. The command-line
         test modes in Program.cs write with Console.WriteLine, which is visible when standard
         output is redirected or piped (for example piping the exe into "more" or a file). -->
    <OutputType>WinExe</OutputType>
    <!-- Windows TFM: needed by C#/WinRT for the Windows MIDI Services (MIDI 2.0) projection. -->
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <!-- Pins the Microsoft.Windows.SDK.NET.Ref projection package that matches the TFM above,
         so builds are reproducible instead of following whatever the installed SDK defaults to. -->
    <WindowsSDKPackageVersion>10.0.26100.57</WindowsSDKPackageVersion>
    <!-- Keep the familiar output folder bin\<Configuration>\net10.0\ (scripts, tasks and docs point there). -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <OutputPath>bin\$(Configuration)\net10.0\</OutputPath>
    <!-- Nullable reference types are on everywhere: a warning-free build is the project rule. -->
    <Nullable>enable</Nullable>
    <!-- System, System.IO, System.Linq, System.Threading(.Tasks)... are imported implicitly. -->
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Raw pointers are used by the Csound C API interop (Interop/, Engine/), the WASAPI COM
         buffers (Audio/), the MIDI, VST3 and Link native bridges (Midi/, Integration/), the GL
         renderer (Visual3D/) and the Paint canvas bitmap writer (Controls/PaintCanvas.cs). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- 64-bit only: csound7_64.dll, the MIDI 2.0 runtime and the native bridges are x64 builds. -->
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>CsoundVisual</RootNamespace>
    <!-- Also fixes the embedded-resource prefix "CsoundVisual." used by GetManifestResourceStream. -->
    <AssemblyName>CsoundVisual</AssemblyName>
    <Version>0.1.0</Version>
    <!-- {Binding} in AXAML is compiled (type-checked against x:DataType) unless a view opts out;
         typos in binding paths become build errors instead of silent run-time failures. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Icon of the .exe (Explorer, taskbar pinning); generated by tools/make_icon.py. -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- NuGet dependencies. Avalonia packages share one version and must be upgraded together. -->
  <ItemGroup>
    <!-- UI framework, its Win32 desktop backend and the Fluent theme (recoloured by App.axaml). -->
    <PackageReference Include="Avalonia" Version="12.1.5" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <!-- The code editor of each tab (syntax highlighting from Editor/Csound.xshd). -->
    <PackageReference Include="Avalonia.AvaloniaEdit" Version="12.0.0" />
    <!-- MVVM source generators: [ObservableProperty] and [RelayCommand] in ViewModels/. -->
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <!-- Windows MIDI Services (MIDI 2.0). The C# projection is generated at build time by CsWinRT. -->
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.2.0" />
    <!-- OpenGL ES bindings used by the 3D views on top of Avalonia's GL context. -->
    <PackageReference Include="Silk.NET.OpenGLES" Version="2.23.0" />
    <!-- Metadata (.winmd) and native runtime of Windows MIDI Services. PrivateAssets="all":
         it is consumed only at build time by CsWinRT and by the copy items below. -->
    <PackageReference Include="Windows.Devices.Midi2" Version="0.99.92-preview.11" PrivateAssets="all" />
  </ItemGroup>

  <!-- CsWinRT: which WinRT namespace to project into C# (only the MIDI 2.0 API, nothing else). -->
  <PropertyGroup>
    <CsWinRTInputs>Windows.Devices.Midi2</CsWinRTInputs>
    <CsWinRTIncludes>Windows.Devices.Midi2</CsWinRTIncludes>
  </PropertyGroup>

  <ItemGroup>
    <!--
      App-local copy of the MIDI 2.0 API, used only when Windows does not provide it in System32
      (MidiApi.IsSystemProvided() tells which copy is active). The .pri must ship with the .dll.
    -->
    <None Include="$(NuGetPackageRoot)windows.devices.midi2\0.99.92-preview.11\runtimes\win-x64\native\Windows.Devices.Midi2.dll"
          Link="Windows.Devices.Midi2.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(NuGetPackageRoot)windows.devices.midi2\0.99.92-preview.11\runtimes\win-x64\native\Windows.Devices.Midi2.pri"
          Link="Windows.Devices.Midi2.pri" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Optional native C++ bridges built by scripts in tools/ (not by this project). Each is copied
       next to the exe only when it exists, so a plain clone builds and runs without them. -->
  <ItemGroup>
    <!-- VST3 host bridge (tools/build_vsthost.ps1 builds it into native\). Optional: without it the app runs and the plug-in chain is disabled. -->
    <None Include="native\CsoundVisualVstHost.dll" Condition="Exists('native\CsoundVisualVstHost.dll')"
          Link="CsoundVisualVstHost.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Ableton Link (tools/build_link.ps1 builds it into native\). Optional: without it the app runs and Link is disabled. -->
    <None Include="native\CsoundVisualLink.dll" Condition="Exists('native\CsoundVisualLink.dll')"
          Link="CsoundVisualLink.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <!-- Files compiled into the assembly (read with GetManifestResourceStream under the names
       "CsoundVisual.<folder>.<file>") and the example folder copied beside the exe. -->
  <ItemGroup>
    <!-- Csound syntax-highlighting definition for AvaloniaEdit (loaded by Views/MainWindow.axaml.cs). -->
    <EmbeddedResource Include="Editor\Csound.xshd" />
    <!-- Start-up demo document, Spanish and English versions (MainViewModel.LoadDemo picks by UI language). -->
    <EmbeddedResource Include="Assets\Demo.csd" />
    <!-- Example collection (tools/import_examples.py): copied next to the exe, read by ExampleCatalog. -->
    <None Update="Examples\**\*" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Assets\DemoEnglish.csd" />
    <!-- Binaural panner template opened from the 3D view (channels az, el, dist). -->
    <EmbeddedResource Include="Assets\Binaural3D.csd" />
    <!-- Synthesised drum kit for Tools › Step sequencer (instr 1..8). -->
    <EmbeddedResource Include="Assets\DrumKit.csd" />
  </ItemGroup>

  <ItemGroup>
    <!-- Window icon and title-bar logo, loaded through avares:// URIs (Avalonia's own resource
         system; separate from the EmbeddedResource items above). -->
    <AvaloniaResource Include="Assets\app.ico" />
    <AvaloniaResource Include="Assets\app.png" />
  </ItemGroup>

</Project>
