<?xml version="1.0" encoding="utf-8"?>
<!--
  NuGet sources for Csound Visual.
  packages-local/ holds Windows.Devices.Midi2 0.99.92-preview.11 (Windows MIDI Services / MIDI 2.0 API),
  which Microsoft publishes on GitHub (https://github.com/microsoft/MIDI/releases/tag/inbox-preview-11)
  and not on nuget.org. Replace it with the in-box/official package once MIDI Services 1.0 ships.
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local" value="packages-local" />
  </packageSources>
</configuration>
